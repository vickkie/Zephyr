VITE_SERVER= ## add your server URL with port (e.g. "http://localhost:3300")
VITE_CLOUDINARY_UPLOAD_PRESET= # upload preset from cloudinary
VITE_CLOUDINARY_CLOUD_NAME= # add your cloud name of cloudinary
VITE_LOCAL_UPLOAD_URL= # eg http://192.168.43.15:7000/api/upload

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
VITE_PAYSTACK_PUBLIC_KEY= ## pk_test_... (safe to expose to frontend)

# Google One Tap (from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID= ## xxxxx.apps.googleusercontent.com
